// ═══════════════════════════════════════════════════════════════════════════════
// Aiking Solutions — database schema
//
// Implements spec §9.3 "Core Schema" in full. Design constraints from §9.1/§9.2:
//
//   • Money is ALWAYS BigInt paise. There is no Decimal or Float column for a
//     monetary value anywhere in this file (§9.1).
//   • Every tenant-scoped table carries tenant_id and indexes it first (§9.2),
//     so a shared-schema multi-tenant query is always index-covered and the
//     optional RLS policies in migrations/rls.sql have a column to key on.
//   • Idempotency is enforced by UNIQUE constraints on the provider's own
//     reference id, not by application-level checks (§8.1, §8.2, §15).
//   • Ledger tables (wallet_transactions, usage_events, communication_events)
//     are append-only by convention — nothing in the codebase updates or
//     deletes them (§10 "Immutable ledger; never edited in place").
// ═══════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer accepts `url` here — the connection string lives in
// prisma.config.ts for CLI/migrate, and is passed to PrismaClient via the
// node-postgres driver adapter at runtime (see src/common/prisma/prisma.service.ts).
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums — mirrored in packages/shared/src/enums.ts for the frontend
// ─────────────────────────────────────────────────────────────────────────────

enum TenantStatus {
  active
  suspended
  pending
}

enum Role {
  super_admin
  manager
  staff
}

enum InviteStatus {
  invited
  active
  revoked
}

enum Channel {
  whatsapp
  email
  call
}

enum UsageEventType {
  whatsapp_message
  email_message
  ai_call_minute
}

enum CostSource {
  PROVIDER_API
  PROVIDER_USAGE
  RATE_CATALOG
  ESTIMATE
}

/// Balance movements only. A reserve-then-confirm hold moves *availability*, not
/// balance, so it lives in `wallet_reservations` — which keeps
/// `sum(amount_paise) = balance_paise + free_credit_balance_paise` exactly true.
enum WalletTransactionType {
  topup_credit
  free_credit_grant
  usage_debit
  free_credit_debit
  adjustment
  refund
}

enum BalanceBucket {
  paid
  free
}

enum LowBalanceBehavior {
  hard_stop
  soft_limit
}

enum ReservationStatus {
  held
  confirmed
  released
}

enum RazorpayOrderStatus {
  created
  attempted
  paid
  failed
}

enum RazorpayPaymentStatus {
  captured
  authorized
  failed
  refunded
}

enum CampaignStatus {
  draft
  scheduled
  queued
  sending
  completed
  completed_with_failures
  halted_insufficient_funds
  cancelled
  failed
}

enum RecipientStatus {
  pending
  queued
  sent
  delivered
  read
  opened
  clicked
  failed
  bounced
  skipped_opted_out
  skipped_insufficient_funds
}

enum TemplateStatus {
  draft
  pending_approval
  approved
  rejected
  paused
}

enum CallDirection {
  outbound
  inbound
}

enum CallStatus {
  queued
  initiated
  ringing
  in_progress
  summarizing
  completed
  no_answer
  busy
  failed
  escalated
}

enum CallOutcome {
  resolved
  follow_up_required
  escalated_to_human
  not_interested
  unreachable
  unknown
}

enum TranscriptSpeaker {
  agent
  customer
  system
}

enum CommunicationEventType {
  whatsapp_sent
  whatsapp_delivered
  whatsapp_read
  whatsapp_failed
  whatsapp_inbound
  email_sent
  email_delivered
  email_opened
  email_clicked
  email_bounced
  call_placed
  call_completed
  call_failed
  call_escalated
  contact_opted_out
  contact_opted_in
}

enum EventDirection {
  outbound
  inbound
  system
}

// ─────────────────────────────────────────────────────────────────────────────
// tenants — tenant company registration, status, plan (§9.3)
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  slug         String       @unique
  status       TenantStatus @default(active)
  plan         String       @default("standard")
  contactEmail String?      @map("contact_email")

  // Spec §4.4 open item — whether Staff may launch campaigns / trigger calls is
  // undecided in the document, so it is configuration rather than a code fork.
  // Both default to false: granting spend rights by default would let Staff draw
  // down the wallet before anyone has decided they may.
  staffCanLaunchCampaigns Boolean @default(false) @map("staff_can_launch_campaigns")
  staffCanTriggerCalls    Boolean @default(false) @map("staff_can_trigger_calls")

  // Spec §5.3 open item — a call that would overdraw the wallet either stops
  // hard or runs against a configurable soft limit.
  lowBalanceBehavior       LowBalanceBehavior @default(hard_stop) @map("low_balance_behavior")
  softLimitPaise           BigInt             @default(0) @map("soft_limit_paise")
  lowBalanceThresholdPaise BigInt             @default(10000) @map("low_balance_threshold_paise")

  // Per-tenant sending identity (spec §6.2 — "the tenant's own sending identity").
  emailFromName         String? @map("email_from_name")
  emailFromAddress      String? @map("email_from_address")
  whatsappPhoneNumberId String? @map("whatsapp_phone_number_id")

  suspendedAt     DateTime? @map("suspended_at")
  suspendedReason String?   @map("suspended_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenantUsers                           TenantUser[]
  sessions                              Session[]
  contacts                              Contact[]
  contactImports                        ContactImport[]
  wallet                                Wallet?
  walletTransactions                    WalletTransaction[]
  reservations                          WalletReservation[]
  razorpayOrders                        RazorpayOrder[]
  razorpayPayments                      RazorpayPayment[]
  pricingRules                          PricingRule[]
  usageEvents                           UsageEvent[]
  campaigns                             Campaign[]
  campaignRecipients                    CampaignRecipient[]
  calls                                 Call[]
  communicationEvents                   CommunicationEvent[]
  templates                             Template[]
  usageRatingSnapshots                  UsageRatingSnapshot[]
  callShadowRatings                     CallShadowRating[]
  callShadowRatingConflicts             CallShadowRatingConflict[]
  whatsappShadowRatings                 WhatsAppShadowRating[]
  whatsappCampaignShadowReconciliations WhatsAppCampaignShadowReconciliation[]
  whatsappShadowRatingConflicts         WhatsAppShadowRatingConflict[]
  emailShadowRatings                    EmailShadowRating[]
  emailCampaignShadowReconciliations    EmailCampaignShadowReconciliation[]
  emailShadowRatingConflicts            EmailShadowRatingConflict[]

  @@index([status])
  @@map("tenants")
}

// ─────────────────────────────────────────────────────────────────────────────
// users — global user accounts, includes the Super Admin flag (§9.3)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String @id @default(uuid()) @db.Uuid
  email        String @unique
  passwordHash String @map("password_hash")
  fullName     String @map("full_name")

  // Spec §4.3 — the JWT carries is_super_admin; a Super Admin has no tenant
  // scope of its own and reaches tenant data only through support access.
  isSuperAdmin Boolean @default(false) @map("is_super_admin")

  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenantUsers         TenantUser[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  @@index([isSuperAdmin])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// tenant_users — per-tenant role assignment, invite status (§9.3)
// ─────────────────────────────────────────────────────────────────────────────

model TenantUser {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  // Only manager | staff are meaningful here; super_admin is a User flag.
  role         Role         @default(staff)
  inviteStatus InviteStatus @default(invited) @map("invite_status")
  invitedBy    String?      @map("invited_by") @db.Uuid
  invitedAt    DateTime     @default(now()) @map("invited_at")
  acceptedAt   DateTime?    @map("accepted_at")
  revokedAt    DateTime?    @map("revoked_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One membership per user per tenant. A user may belong to several tenants.
  @@unique([tenantId, userId])
  @@index([tenantId, role])
  @@index([userId])
  @@map("tenant_users")
}

// ─────────────────────────────────────────────────────────────────────────────
// sessions — revocable server-side authentication sessions
// ─────────────────────────────────────────────────────────────────────────────

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tenantId         String?   @map("tenant_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  role             Role
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  revokedReason    String?   @map("revoked_reason")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([expiresAt])
  @@map("sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// password_reset_tokens — time-limited, single-use password reset tokens
// ─────────────────────────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// contacts — the tenant's CRM records (§7, §9.3)
// ─────────────────────────────────────────────────────────────────────────────

model Contact {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  fullName String  @map("full_name")
  phone    String?
  email    String?

  // Spec §7 — flexible per-tenant fields (a logistics tenant's shipment
  // reference or delivery zone) with no per-tenant schema change.
  customFields Json     @default("{}") @map("custom_fields")
  tags         String[] @default([])

  // Spec §12 — WhatsApp opt-in captured per contact; opt-out honored immediately.
  whatsappOptedIn Boolean   @default(false) @map("whatsapp_opted_in")
  emailOptedIn    Boolean   @default(true) @map("email_opted_in")
  optedOutAt      DateTime? @map("opted_out_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// CRM deletion is archival: historical calls, recipients and timeline rows retain this contact.
  deletedAt DateTime? @map("deleted_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaignRecipients  CampaignRecipient[]
  calls               Call[]
  communicationEvents CommunicationEvent[]
  usageEvents         UsageEvent[]

  // Phone and email are unique per tenant, not globally: two tenants may
  // legitimately hold the same customer.
  @@unique([tenantId, phone])
  @@unique([tenantId, email])
  @@index([tenantId, createdAt])
  @@index([tenantId, fullName])
  @@map("contacts")
}

/// Durable state for tenant CSV imports. The CSV itself stays in object storage.
model ContactImport {
  id                           String    @id @default(uuid()) @db.Uuid
  tenantId                     String    @map("tenant_id") @db.Uuid
  status                       String    @default("queued")
  objectKey                    String    @map("object_key")
  unknownColumnsAsCustomFields Boolean   @default(true) @map("unknown_columns_as_custom_fields")
  totalRows                    Int       @default(0) @map("total_rows")
  processedRows                Int       @default(0) @map("processed_rows")
  successCount                 Int       @default(0) @map("success_count")
  createdCount                 Int       @default(0) @map("created_count")
  updatedCount                 Int       @default(0) @map("updated_count")
  failureCount                 Int       @default(0) @map("failure_count")
  errors                       Json      @default("[]")
  errorSummary                 String?   @map("error_summary")
  startedAt                    DateTime? @map("started_at")
  completedAt                  DateTime? @map("completed_at")
  createdAt                    DateTime  @default(now()) @map("created_at")
  updatedAt                    DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("contact_imports")
}

// ─────────────────────────────────────────────────────────────────────────────
// wallets — one row per tenant: balance, free-credit balance (§9.3)
//
// This is the row every balance mutation takes a SELECT … FOR UPDATE lock on
// (§9.1 "row-level locking prevents race conditions").
// ─────────────────────────────────────────────────────────────────────────────

model Wallet {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  /// Paid balance from Razorpay top-ups, in paise.
  balancePaise BigInt @default(0) @map("balance_paise")

  /// Free credits granted at onboarding, tracked separately so free-funded and
  /// paid-funded usage stay separately reportable (§8.3).
  freeCreditBalancePaise BigInt @default(0) @map("free_credit_balance_paise")

  /// Held by in-flight reservations — funds committed to a provider call that
  /// has not yet confirmed (§15 reserve-then-confirm).
  reservedPaise BigInt @default(0) @map("reserved_paise")

  /// Running totals, maintained inside the same locked transaction. Denormalised
  /// deliberately: a Manager's ledger view would otherwise aggregate the whole
  /// append-only history on every page load.
  lifetimeCreditedPaise BigInt @default(0) @map("lifetime_credited_paise")
  lifetimeDebitedPaise  BigInt @default(0) @map("lifetime_debited_paise")

  currency  String   @default("INR")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

// ─────────────────────────────────────────────────────────────────────────────
// wallet_transactions — immutable append-only ledger of every credit and debit
// (§9.3, §10 "never edited in place, only appended")
// ─────────────────────────────────────────────────────────────────────────────

model WalletTransaction {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  type   WalletTransactionType
  bucket BalanceBucket         @default(paid)

  /// Signed: positive credits, negative debits. Paise.
  amountPaise BigInt @map("amount_paise")

  /// Spendable balance (paid + free) immediately after this row was written.
  /// Captured inside the locked transaction, so the ledger is self-auditing.
  balanceAfterPaise BigInt @map("balance_after_paise")

  description String

  /// What caused this movement — 'razorpay_payment' | 'usage_event' |
  /// 'reservation' | 'onboarding' | 'manual'.
  referenceType String? @map("reference_type")
  referenceId   String? @map("reference_id")

  /// Spec §15 — idempotency key on every balance mutation. UNIQUE per tenant, so
  /// a redelivered webhook or retried job cannot double-apply. Nullable because
  /// a Super Admin's manual adjustment has no external reference.
  idempotencyKey String? @map("idempotency_key")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey], name: "wallet_tx_tenant_idempotency")
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, type])
  @@map("wallet_transactions")
}

// ─────────────────────────────────────────────────────────────────────────────
// wallet_reservations — the reserve-then-confirm hold (§15)
//
// Not named in §9.3's table list, but §15 names reserve-then-confirm as the
// mitigation for "billing a tenant for a message/call that then fails at the
// provider". A hold needs somewhere to live.
// ─────────────────────────────────────────────────────────────────────────────

model WalletReservation {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  amountPaise BigInt            @map("amount_paise")
  status      ReservationStatus @default(held)

  /// What the hold is for — 'campaign_recipient' | 'call'.
  referenceType String? @map("reference_type")
  referenceId   String? @map("reference_id")

  /// Same idempotency discipline as the ledger: a retried job re-reserving the
  /// same unit of work finds the existing hold instead of taking a second one.
  idempotencyKey String @map("idempotency_key")

  /// Set on confirm — the amount actually charged, which may differ from the
  /// held amount (a call's real duration versus its estimate).
  settledAmountPaise BigInt?   @map("settled_amount_paise")
  confirmedAt        DateTime? @map("confirmed_at")
  releasedAt         DateTime? @map("released_at")
  releaseReason      String?   @map("release_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey], name: "reservation_tenant_idempotency")
  @@index([tenantId, status])
  @@map("wallet_reservations")
}

// ─────────────────────────────────────────────────────────────────────────────
// razorpay_orders / razorpay_payments — order/payment records, idempotency key,
// signature verification status (§8.1, §9.3)
// ─────────────────────────────────────────────────────────────────────────────

model RazorpayOrder {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Razorpay's own order id (order_...). Unique — one local row per remote order.
  razorpayOrderId String @unique @map("razorpay_order_id")

  amountPaise BigInt              @map("amount_paise")
  currency    String              @default("INR")
  status      RazorpayOrderStatus @default(created)
  receipt     String?
  notes       Json                @default("{}")

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments RazorpayPayment[]

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("razorpay_orders")
}

model RazorpayPayment {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  orderId  String? @map("order_id") @db.Uuid

  /// Spec §8.1 — "idempotent on payment_id, since webhooks can be redelivered".
  /// This UNIQUE constraint is the whole mechanism: a duplicate
  /// payment.captured hits it and the handler returns the existing row rather
  /// than crediting the wallet twice (§15).
  razorpayPaymentId String @unique @map("razorpay_payment_id")
  razorpayOrderId   String @map("razorpay_order_id")

  amountPaise BigInt                @map("amount_paise")
  currency    String                @default("INR")
  status      RazorpayPaymentStatus
  method      String?

  /// Spec §12 — every webhook is signature-verified before it is trusted.
  /// Recorded so a payment credited on an unverified signature is impossible to
  /// hide after the fact.
  signatureVerified Boolean @default(false) @map("signature_verified")

  /// Set once the wallet credit has actually been applied. Distinguishes "we
  /// know about this payment" from "we have credited it".
  creditedAt          DateTime? @map("credited_at")
  walletTransactionId String?   @map("wallet_transaction_id") @db.Uuid

  /// Raw provider payload, kept verbatim for dispute resolution.
  rawPayload Json     @default("{}") @map("raw_payload")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  RazorpayOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([razorpayOrderId])
  @@map("razorpay_payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// pricing_rules — per-event-type pricing, editable without redeploy (§9.3)
// ─────────────────────────────────────────────────────────────────────────────

model PricingRule {
  id String @id @default(uuid()) @db.Uuid

  /// NULL = the platform default, applied to any tenant without an override.
  /// This is the one tenant-scoped table where NULL tenant_id is meaningful.
  tenantId String? @map("tenant_id") @db.Uuid

  eventType      UsageEventType @map("event_type")
  unitPricePaise BigInt         @map("unit_price_paise")
  currency       String         @default("INR")

  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  active        Boolean   @default(true)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, eventType, active])
  @@index([eventType, active])
  @@map("pricing_rules")
}

// ─────────────────────────────────────────────────────────────────────────────
// usage_events — immutable log of every billable action; audit trail and
// billing source (§8.2, §9.3)
// ─────────────────────────────────────────────────────────────────────────────

model UsageEvent {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  eventType UsageEventType @map("event_type")

  /// Messages for WhatsApp/email; billable minutes for a call (§5.3).
  quantity Int @default(1)

  unitPricePaise   BigInt @map("unit_price_paise")
  totalChargePaise BigInt @map("total_charge_paise")

  /// Spec §8.2 — "idempotency enforced via a unique constraint on the provider's
  /// own reference ID (e.g. the WhatsApp message ID or Plivo call UUID)".
  idempotencyKey String @map("idempotency_key")

  /// Which balance actually funded it, for §8.3 free-vs-paid reporting.
  bucket BalanceBucket @default(paid)

  contactId  String? @map("contact_id") @db.Uuid
  campaignId String? @map("campaign_id") @db.Uuid
  callId     String? @map("call_id") @db.Uuid

  walletTransactionId String? @map("wallet_transaction_id") @db.Uuid

  metadata   Json     @default("{}")
  occurredAt DateTime @default(now()) @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact  Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  call     Call?     @relation(fields: [callId], references: [id], onDelete: SetNull)

  @@unique([tenantId, idempotencyKey], name: "usage_tenant_idempotency")
  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([tenantId, eventType, occurredAt])
  @@map("usage_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// usage_rating_snapshots — immutable historical rating records
// ─────────────────────────────────────────────────────────────────────────────

model UsageRatingSnapshot {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  channel           Channel
  provider          String
  providerReference String? @map("provider_reference")

  /// Exact billing units (e.g. seconds for calls, messages, characters)
  quantity Int    @default(1)
  unit     String
  currency String @default("INR")

  rateMicroPaise         BigInt? @map("rate_micro_paise")
  providerCostMicroPaise BigInt? @map("provider_cost_micro_paise")
  markupAmountMicroPaise BigInt? @map("markup_amount_micro_paise")
  retailAmountMicroPaise BigInt? @map("retail_amount_micro_paise")

  providerCostPaise   BigInt @map("provider_cost_paise")
  markupBps           Int    @map("markup_bps")
  markupAmountPaise   BigInt @map("markup_amount_paise")
  customerChargePaise BigInt @map("customer_charge_paise")

  costSource      CostSource @map("cost_source")
  policyReference String?    @map("policy_reference")

  /// Authoritative usage reference / idempotency key, unique per tenant
  usageReference String @map("usage_reference")

  metadata  Json     @default("{}")
  ratedAt   DateTime @default(now()) @map("rated_at")
  settledAt DateTime @default(now()) @map("settled_at")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, usageReference], name: "usage_rating_snapshot_tenant_usage_reference")
  @@index([tenantId, channel, settledAt(sort: Desc)])
  @@index([provider, settledAt(sort: Desc)])
  @@map("usage_rating_snapshots")
}

// ─────────────────────────────────────────────────────────────────────────────
// call_shadow_ratings — observational voice shadow ratings (Phase 4)
// ─────────────────────────────────────────────────────────────────────────────

model CallShadowRating {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  callId   String @map("call_id") @db.Uuid

  provider          String?
  providerReference String? @map("provider_reference")
  billableSeconds   Int?    @map("billable_seconds")

  rateMicroPaise         BigInt? @map("rate_micro_paise")
  providerCostMicroPaise BigInt? @map("provider_cost_micro_paise")
  markupBps              Int?    @map("markup_bps")
  markupAmountMicroPaise BigInt? @map("markup_amount_micro_paise")
  retailAmountMicroPaise BigInt? @map("retail_amount_micro_paise")

  legacyCustomerChargePaise BigInt  @map("legacy_customer_charge_paise")
  shadowCustomerChargePaise BigInt? @map("shadow_customer_charge_paise")
  differencePaise           BigInt? @map("difference_paise")

  status            String // 'RATED' | 'COST_UNAVAILABLE' | 'USAGE_NOT_FOUND' | 'PROVIDER_UNKNOWN'
  unavailableReason String? @map("unavailable_reason")

  costSource      CostSource? @map("cost_source")
  providerRateId  String?     @map("provider_rate_id") @db.Uuid
  policyReference String?     @map("policy_reference")

  occurredAt DateTime @map("occurred_at")
  ratedAt    DateTime @default(now()) @map("rated_at")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  call         Call          @relation(fields: [callId], references: [id], onDelete: Restrict)
  providerRate ProviderRate? @relation(fields: [providerRateId], references: [id], onDelete: Restrict)

  conflicts CallShadowRatingConflict[]

  @@unique([tenantId, callId], name: "call_shadow_ratings_tenant_call_unique")
  @@index([tenantId, ratedAt(sort: Desc)])
  @@index([callId])
  @@index([status])
  @@map("call_shadow_ratings")
}

// ─────────────────────────────────────────────────────────────────────────────
// call_shadow_rating_conflicts — append-only duplicate replay audit log (Phase 4.1)
// ─────────────────────────────────────────────────────────────────────────────

model CallShadowRatingConflict {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  callId         String   @map("call_id") @db.Uuid
  shadowRatingId String   @map("shadow_rating_id") @db.Uuid
  reason         String
  incomingValues Json     @map("incoming_values")
  existingValues Json     @map("existing_values")
  detectedAt     DateTime @default(now()) @map("detected_at")

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  call         Call             @relation(fields: [callId], references: [id], onDelete: Restrict)
  shadowRating CallShadowRating @relation(fields: [shadowRatingId], references: [id], onDelete: Restrict)

  @@index([tenantId, detectedAt(sort: Desc)])
  @@index([callId])
  @@index([shadowRatingId])
  @@map("call_shadow_rating_conflicts")
}

// ─────────────────────────────────────────────────────────────────────────────
// provider_rates — wholesale provider rate catalog entries (Platform Scoped)
// ─────────────────────────────────────────────────────────────────────────────

model ProviderRate {
  id                 String    @id @default(uuid()) @db.Uuid
  provider           String
  channel            Channel
  destinationPattern String    @default("*") @map("destination_pattern")
  category           String?
  unit               String
  rateMicroPaise     BigInt    @map("rate_micro_paise")
  currency           String    @default("INR")
  effectiveFrom      DateTime  @default(now()) @map("effective_from")
  effectiveTo        DateTime? @map("effective_to")
  active             Boolean   @default(true)
  version            Int       @default(1)
  description        String?
  createdBy          String?   @map("created_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  callShadowRatings     CallShadowRating[]
  whatsappShadowRatings WhatsAppShadowRating[]
  emailShadowRatings    EmailShadowRating[]

  @@index([provider, channel, active, effectiveFrom])
  @@index([channel, active])
  @@map("provider_rates")
}

// ─────────────────────────────────────────────────────────────────────────────
// templates — WhatsApp/email template content and approval status (§6.1, §9.3)
// ─────────────────────────────────────────────────────────────────────────────

model Template {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name     String
  channel  Channel
  status   TemplateStatus @default(draft)
  language String         @default("en")

  /// Email only.
  subject String?
  body    String

  /// Placeholders found in `body`, e.g. ["fullName","shipmentRef"].
  variables String[] @default([])

  /// Spec §6.1 — Meta's pre-approval workflow has multi-day external lead time,
  /// so submission state is tracked explicitly and campaigns refuse to launch on
  /// a WhatsApp template that is not `approved`.
  providerTemplateName String?   @map("provider_template_name")
  submittedAt          DateTime? @map("submitted_at")
  approvedAt           DateTime? @map("approved_at")
  rejectionReason      String?   @map("rejection_reason")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@unique([tenantId, name, channel])
  @@index([tenantId, channel, status])
  @@map("templates")
}

// ─────────────────────────────────────────────────────────────────────────────
// campaigns — channel, template, schedule (§9.3)
// ─────────────────────────────────────────────────────────────────────────────

model Campaign {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name       String
  channel    Channel
  status     CampaignStatus @default(draft)
  templateId String?        @map("template_id") @db.Uuid

  /// Per-campaign variable defaults, merged beneath each contact's own fields.
  variables Json @default("{}")

  scheduledAt DateTime? @map("scheduled_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  /// Computed at launch from pricing_rules × recipient count, so the wallet
  /// pre-check in §8.2 has something to compare against.
  estimatedCostPaise BigInt @default(0) @map("estimated_cost_paise")
  actualCostPaise    BigInt @default(0) @map("actual_cost_paise")

  failureReason String? @map("failure_reason")

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant                                Tenant                                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template                              Template?                              @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients                            CampaignRecipient[]
  usageEvents                           UsageEvent[]
  communicationEvents                   CommunicationEvent[]
  whatsappShadowRatings                 WhatsAppShadowRating[]
  whatsappCampaignShadowReconciliations WhatsAppCampaignShadowReconciliation[]
  emailShadowRatings                    EmailShadowRating[]
  emailCampaignShadowReconciliations    EmailCampaignShadowReconciliation[]

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, status])
  @@map("campaigns")
}

// ─────────────────────────────────────────────────────────────────────────────
// campaign_recipients — per-recipient delivery/interaction status (§9.3)
//
// Spec §6.1: terminal failures are "surfaced per-recipient rather than failing
// the whole campaign", so per-recipient error detail lives here.
// ─────────────────────────────────────────────────────────────────────────────

model CampaignRecipient {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  campaignId String @map("campaign_id") @db.Uuid
  contactId  String @map("contact_id") @db.Uuid

  /// Phone number or email address resolved at launch, so a later edit to the
  /// contact does not rewrite history.
  destination String
  status      RecipientStatus @default(pending)

  /// The provider's message id — WhatsApp wamid or SES message id. Doubles as
  /// the metering idempotency key (§8.2) and the join key for delivery webhooks.
  providerMessageId String? @map("provider_message_id")

  errorCode    String? @map("error_code")
  errorMessage String? @map("error_message")
  attempts     Int     @default(0)

  costPaise BigInt? @map("cost_paise")

  queuedAt    DateTime? @map("queued_at")
  sentAt      DateTime? @map("sent_at")
  deliveredAt DateTime? @map("delivered_at")
  readAt      DateTime? @map("read_at")
  openedAt    DateTime? @map("opened_at")
  clickedAt   DateTime? @map("clicked_at")
  failedAt    DateTime? @map("failed_at")

  provider             String?   @map("provider")
  providerBillable     Boolean?  @map("provider_billable")
  providerCategory     String?   @map("provider_category")
  providerPricingModel String?   @map("provider_pricing_model")
  pricingObservedAt    DateTime? @map("pricing_observed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Restrict)

  whatsappShadowRatings         WhatsAppShadowRating[]
  whatsappShadowRatingConflicts WhatsAppShadowRatingConflict[]
  emailShadowRatings            EmailShadowRating[]
  emailShadowRatingConflicts    EmailShadowRatingConflict[]

  /// A contact appears at most once per campaign.
  @@unique([campaignId, contactId])
  /// Delivery webhooks arrive keyed only on the provider's message id.
  @@index([providerMessageId])
  @@index([tenantId, campaignId, status])
  @@map("campaign_recipients")
}

// ─────────────────────────────────────────────────────────────────────────────
// calls — AI call records: transcript, summary, next-action, recording
// reference, duration (§5, §9.3)
// ─────────────────────────────────────────────────────────────────────────────


model Call {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  contactId String @map("contact_id") @db.Uuid

  direction CallDirection @default(outbound)
  status    CallStatus    @default(queued)
  callType     String  @default("ai") @map("call_type")
  bridgeNumber String? @map("bridge_number")
  outcome   CallOutcome?

  providerCallId String? @unique @map("provider_call_id")

  provider String? @map("provider")

  fromNumber String @map("from_number")
  toNumber   String @map("to_number")

  durationSeconds Int     @default(0) @map("duration_seconds")
  billedMinutes   Int     @default(0) @map("billed_minutes")
  costPaise       BigInt? @map("cost_paise")

  recordingKey             String? @map("recording_key")
  recordingDurationSeconds Int?    @map("recording_duration_seconds")

  summary    String?
  nextAction String? @map("next_action")

  scriptId      String? @map("script_id")
  promptVersion String? @map("prompt_version")
  objective     String?

  escalatedAt      DateTime? @map("escalated_at")
  escalationReason String?   @map("escalation_reason")

  failureReason String? @map("failure_reason")
  metadata      Json    @default("{}")

  startedAt DateTime? @map("started_at")
  endedAt   DateTime? @map("ended_at")
  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant                    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact                   Contact                    @relation(fields: [contactId], references: [id], onDelete: Restrict)
  transcriptTurns           CallTranscriptTurn[]
  usageEvents               UsageEvent[]
  communicationEvents       CommunicationEvent[]
  callShadowRatings         CallShadowRating[]
  callShadowRatingConflicts CallShadowRatingConflict[]

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, status])
  @@index([tenantId, contactId])
  @@map("calls")
}

// ─────────────────────────────────────────────────────────────────────────────
// call_transcript_turns — the turn-by-turn transcript from §5.1 steps 2–3
//
// Kept as rows rather than a JSON blob on `calls` so a transcript can be paged
// and searched. §10 classifies raw transcripts as High sensitivity.
// ─────────────────────────────────────────────────────────────────────────────

model CallTranscriptTurn {
  id     String @id @default(uuid()) @db.Uuid
  callId String @map("call_id") @db.Uuid

  sequence Int
  speaker  TranscriptSpeaker
  text     String

  /// Deepgram confidence 0–1, where the provider reports it.
  confidence Float?
  atSeconds  Float  @default(0) @map("at_seconds")

  createdAt DateTime @default(now()) @map("created_at")

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@unique([callId, sequence])
  @@index([callId, sequence])
  @@map("call_transcript_turns")
}

// ─────────────────────────────────────────────────────────────────────────────
// communication_events — the unified log powering the 360° timeline (§6.4, §9.3)
//
// Spec §6.4: "keyed on contact_id and occurred_at… a single indexed query over
// this table rather than three separate per-channel queries stitched together at
// the UI layer". The composite index below is what makes that true.
// ─────────────────────────────────────────────────────────────────────────────

model CommunicationEvent {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  contactId String @map("contact_id") @db.Uuid

  channel   Channel
  eventType CommunicationEventType @map("event_type")
  direction EventDirection         @default(outbound)

  /// Human-readable one-liner rendered directly in the timeline.
  summary String

  campaignId String? @map("campaign_id") @db.Uuid
  callId     String? @map("call_id") @db.Uuid

  /// Provider message id / call uuid, so an event can be traced to its provider.
  providerReference String? @map("provider_reference")

  metadata   Json     @default("{}")
  occurredAt DateTime @default(now()) @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact  Contact   @relation(fields: [contactId], references: [id], onDelete: Restrict)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  call     Call?     @relation(fields: [callId], references: [id], onDelete: SetNull)

  /// The 360° timeline query (§6.4) — one contact, newest first.
  @@index([tenantId, contactId, occurredAt(sort: Desc)])
  /// Tenant-wide activity feed and per-channel reporting (§11.1).
  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([tenantId, channel, occurredAt(sort: Desc)])
  @@map("communication_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// webhook_deliveries — inbound webhook audit log
//
// Not in §9.3's list, but §12 requires every inbound webhook be
// signature-verified before processing, and §16 requires that idempotency be
// demonstrably tested. Recording each delivery with its verification result and
// whether it was a replay is what makes both auditable.
// ─────────────────────────────────────────────────────────────────────────────

model WebhookDelivery {
  id String @id @default(uuid()) @db.Uuid

  /// 'razorpay' | 'meta' | 'plivo' | 'email'
  provider  String
  eventType String? @map("event_type")

  /// The provider's own event id where it supplies one — the replay key.
  providerEventId String? @map("provider_event_id")

  signatureVerified   Boolean   @default(false) @map("signature_verified")
  /// True when this delivery matched an already-processed event and was skipped.
  duplicate           Boolean   @default(false)
  processed           Boolean   @default(false)
  processing          Boolean   @default(false)
  attemptCount        Int       @default(0) @map("attempt_count")
  processingStartedAt DateTime? @map("processing_started_at")
  errorMessage        String?   @map("error_message")

  payload    Json     @default("{}")
  receivedAt DateTime @default(now()) @map("received_at")

  @@unique([provider, providerEventId])
  @@index([provider, receivedAt(sort: Desc)])
  @@map("webhook_deliveries")
}

// ─────────────────────────────────────────────────────────────────────────────
// whatsapp_shadow_ratings — observational WhatsApp shadow ratings (Phase 5)
// ─────────────────────────────────────────────────────────────────────────────

model WhatsAppShadowRating {
  id                  String @id @default(uuid()) @db.Uuid
  tenantId            String @map("tenant_id") @db.Uuid
  campaignId          String @map("campaign_id") @db.Uuid
  campaignRecipientId String @map("campaign_recipient_id") @db.Uuid
  ratingVersion       Int    @default(1) @map("rating_version")

  provider          String?
  providerMessageId String?  @map("provider_message_id")
  destination       String
  category          String?
  pricingModel      String?  @map("pricing_model")
  billable          Boolean? @map("billable")

  rateMicroPaise         BigInt? @map("rate_micro_paise")
  providerCostMicroPaise BigInt? @map("provider_cost_micro_paise")

  legacyCustomerChargePaise BigInt @map("legacy_customer_charge_paise")

  status            String // 'RATED' | 'COST_UNAVAILABLE' | 'CATEGORY_UNAVAILABLE' | 'NON_BILLABLE' | 'PROVIDER_UNKNOWN'
  unavailableReason String? @map("unavailable_reason")

  costSource      CostSource? @map("cost_source")
  providerRateId  String?     @map("provider_rate_id") @db.Uuid
  policyReference String?     @map("policy_reference")

  occurredAt DateTime? @map("occurred_at")
  ratedAt    DateTime  @default(now()) @map("rated_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant            Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  campaign          Campaign                       @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  campaignRecipient CampaignRecipient              @relation(fields: [campaignRecipientId], references: [id], onDelete: Restrict)
  providerRate      ProviderRate?                  @relation(fields: [providerRateId], references: [id], onDelete: Restrict)
  conflicts         WhatsAppShadowRatingConflict[]

  @@unique([tenantId, campaignRecipientId, ratingVersion], name: "whatsapp_shadow_ratings_tenant_recipient_version_unique")
  @@index([tenantId, campaignRecipientId, ratingVersion(sort: Desc)], name: "whatsapp_shadow_ratings_tenant_recipient_version_idx")
  @@index([tenantId, ratedAt(sort: Desc)])
  @@index([campaignId])
  @@index([providerMessageId])
  @@index([status])
  @@map("whatsapp_shadow_ratings")
}

// ─────────────────────────────────────────────────────────────────────────────
// whatsapp_campaign_shadow_reconciliations — aggregate campaign shadow reconciliation (Phase 5)
// ─────────────────────────────────────────────────────────────────────────────

model WhatsAppCampaignShadowReconciliation {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  campaignId String @map("campaign_id") @db.Uuid
  version    Int    @default(1)

  totalRecipients       Int @map("total_recipients")
  eligibleRecipients    Int @default(0) @map("eligible_recipients")
  ratedRecipients       Int @map("rated_recipients")
  unratedRecipients     Int @map("unrated_recipients")
  nonBillableRecipients Int @map("non_billable_recipients")

  totalProviderCostMicroPaise BigInt @map("total_provider_cost_micro_paise")
  markupBps                   Int    @map("markup_bps")
  markupAmountMicroPaise      BigInt @map("markup_amount_micro_paise")
  retailAmountMicroPaise      BigInt @map("retail_amount_micro_paise")

  ratedLegacyTotalPaise BigInt @map("rated_legacy_total_paise")
  ratedShadowTotalPaise BigInt @map("rated_shadow_total_paise")
  signedDifferencePaise BigInt @map("signed_difference_paise")
  varianceBps           Int    @map("variance_bps")

  status    String // 'COMPLETE' | 'PARTIAL' | 'UNAVAILABLE'
  isFinal   Boolean  @default(false) @map("is_final")
  ratedAt   DateTime @default(now()) @map("rated_at")
  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  @@unique([tenantId, campaignId, version], name: "whatsapp_campaign_reconciliations_tenant_campaign_version_unique")
  @@index([tenantId, ratedAt(sort: Desc)])
  @@index([tenantId, campaignId, version(sort: Desc)], name: "whatsapp_campaign_reconciliations_tenant_campaign_version_idx")
  @@map("whatsapp_campaign_shadow_reconciliations")
}

// ─────────────────────────────────────────────────────────────────────────────
// whatsapp_shadow_rating_conflicts — append-only duplicate replay audit log (Phase 5)
// ─────────────────────────────────────────────────────────────────────────────

model WhatsAppShadowRatingConflict {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  campaignRecipientId String   @map("campaign_recipient_id") @db.Uuid
  shadowRatingId      String   @map("shadow_rating_id") @db.Uuid
  reason              String
  incomingValues      Json     @map("incoming_values")
  existingValues      Json     @map("existing_values")
  detectedAt          DateTime @default(now()) @map("detected_at")

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recipient    CampaignRecipient    @relation(fields: [campaignRecipientId], references: [id], onDelete: Restrict)
  shadowRating WhatsAppShadowRating @relation(fields: [shadowRatingId], references: [id], onDelete: Restrict)

  @@index([tenantId, detectedAt(sort: Desc)])
  @@index([campaignRecipientId])
  @@index([shadowRatingId])
  @@map("whatsapp_shadow_rating_conflicts")
}

// Phase 6: immutable, observational email provider-cost ratings.
model EmailShadowRating {
  id                  String @id @default(uuid()) @db.Uuid
  tenantId            String @map("tenant_id") @db.Uuid
  campaignId          String @map("campaign_id") @db.Uuid
  campaignRecipientId String @map("campaign_recipient_id") @db.Uuid
  ratingVersion       Int    @default(1) @map("rating_version")

  provider          String?
  providerMessageId String? @map("provider_message_id")
  destination       String
  quantity          Int     @default(1)
  unit              String  @default("email")

  rateMicroPaise            BigInt? @map("rate_micro_paise")
  providerCostMicroPaise    BigInt? @map("provider_cost_micro_paise")
  legacyCustomerChargePaise BigInt? @map("legacy_customer_charge_paise")

  status            String
  unavailableReason String?     @map("unavailable_reason")
  costSource        CostSource? @map("cost_source")
  providerRateId    String?     @map("provider_rate_id") @db.Uuid
  policyReference   String?     @map("policy_reference")
  occurredAt        DateTime?   @map("occurred_at")
  ratedAt           DateTime    @default(now()) @map("rated_at")
  createdAt         DateTime    @default(now()) @map("created_at")

  tenant            Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  campaign          Campaign                    @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  campaignRecipient CampaignRecipient           @relation(fields: [campaignRecipientId], references: [id], onDelete: Restrict)
  providerRate      ProviderRate?               @relation(fields: [providerRateId], references: [id], onDelete: Restrict)
  conflicts         EmailShadowRatingConflict[]

  @@unique([tenantId, campaignRecipientId, ratingVersion], name: "email_shadow_ratings_tenant_recipient_version_unique")
  @@index([tenantId, campaignRecipientId, ratingVersion(sort: Desc)], name: "email_shadow_ratings_tenant_recipient_version_idx")
  @@index([tenantId, ratedAt(sort: Desc)])
  @@index([campaignId])
  @@index([providerMessageId])
  @@index([status])
  @@map("email_shadow_ratings")
}

model EmailCampaignShadowReconciliation {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  campaignId String  @map("campaign_id") @db.Uuid
  version    Int     @default(1)
  isFinal    Boolean @default(false) @map("is_final")

  totalRecipients    Int @map("total_recipients")
  eligibleRecipients Int @map("eligible_recipients")
  ratedRecipients    Int @map("rated_recipients")
  unratedRecipients  Int @map("unrated_recipients")

  totalProviderCostMicroPaise BigInt @map("total_provider_cost_micro_paise")
  markupBps                   Int    @map("markup_bps")
  markupAmountMicroPaise      BigInt @map("markup_amount_micro_paise")
  retailAmountMicroPaise      BigInt @map("retail_amount_micro_paise")
  ratedLegacyTotalPaise       BigInt @map("rated_legacy_total_paise")
  ratedShadowTotalPaise       BigInt @map("rated_shadow_total_paise")
  signedDifferencePaise       BigInt @map("signed_difference_paise")
  varianceBps                 Int    @map("variance_bps")

  status    String
  ratedAt   DateTime @default(now()) @map("rated_at")
  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  @@unique([tenantId, campaignId, version], name: "email_campaign_reconciliations_tenant_campaign_version_unique")
  @@index([tenantId, ratedAt(sort: Desc)])
  @@index([tenantId, campaignId, version(sort: Desc)], name: "email_campaign_reconciliations_tenant_campaign_version_idx")
  @@map("email_campaign_shadow_reconciliations")
}

model EmailShadowRatingConflict {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  campaignRecipientId String   @map("campaign_recipient_id") @db.Uuid
  shadowRatingId      String   @map("shadow_rating_id") @db.Uuid
  reason              String
  incomingValues      Json     @map("incoming_values")
  existingValues      Json     @map("existing_values")
  detectedAt          DateTime @default(now()) @map("detected_at")

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recipient    CampaignRecipient @relation(fields: [campaignRecipientId], references: [id], onDelete: Restrict)
  shadowRating EmailShadowRating @relation(fields: [shadowRatingId], references: [id], onDelete: Restrict)

  @@index([tenantId, detectedAt(sort: Desc)])
  @@index([campaignRecipientId])
  @@index([shadowRatingId])
  @@map("email_shadow_rating_conflicts")
}
