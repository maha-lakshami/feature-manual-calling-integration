// Prisma schema for Manual Calling CRM

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CallStatus {
  INITIATING
  RINGING
  CONNECTED
  COMPLETED
  FAILED
  BUSY
  NO_ANSWER
}

enum CallOutcome {
  INTERESTED
  FOLLOW_UP_REQUIRED
  CALL_BACK_REQUESTED
  NOT_INTERESTED
  PRICE_OBJECTION
  NEEDS_DISCUSSION
  DECISION_PENDING
  MEETING_REQUIRED
  DEMO_REQUIRED
  CONVERTED
  NO_RESPONSE
  WRONG_NUMBER
  LOST
  OTHER
}

enum InterestLevel {
  HIGH
  MEDIUM
  LOW
  UNKNOWN
}

enum NextAction {
  FOLLOW_UP
  CALL_BACK
  SEND_QUOTATION
  SEND_INFORMATION
  SCHEDULE_MEETING
  SCHEDULE_DEMO
  WAIT_FOR_CUSTOMER
  MOVE_TO_ONBOARDING
  NO_ACTION
  RETRY_CALL
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum TaskType {
  CALL
}

enum TaskStatus {
  PENDING
  COMPLETED
  CANCELLED
}

/**
 * Payment status used for Razorpay payments.
 */
enum PaymentStatus {
  CREATED
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

model Customer {
  id         String    @id @default(cuid())
  name       String
  phone      String
  email      String?
  status     String?
  leadSource String?
  priority   Priority?
  assignedTo String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  calls         Call[]
  followUpTasks FollowUpTask[]
  payments      Payment[]

  @@index([phone])
  @@index([assignedTo])
  @@index([status])
  @@index([leadSource])
  @@index([priority])
}

model Call {
  id              String     @id @default(cuid())
  customerId      String
  salespersonId   String
  provider        String     @default("plivo")
  providerCallId  String?    @unique
  status          CallStatus @default(INITIATING)
  startedAt       DateTime?
  endedAt         DateTime?
  durationSeconds Int?
  manualNotes     String?
  createdAt       DateTime   @default(now())

  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  aiAnalysis   CallAIAnalysis?
  followUpTask FollowUpTask?
  payment      Payment?

  @@index([customerId])
  @@index([salespersonId])
  @@index([status])
  @@index([createdAt])
}

model CallAIAnalysis {
  id               String        @id @default(cuid())
  callId           String        @unique
  summary          String
  outcome          CallOutcome
  interest         InterestLevel
  requirement      String?
  objection        String?
  nextAction       NextAction
  followUpRequired Boolean       @default(false)
  followUpDate     DateTime?
  followUpTime     String?
  priority         Priority
  reason           String
  confidence       Float
  model            String

  // Human review fields
  humanReviewed Boolean   @default(false)
  reviewedAt    DateTime?
  reviewedBy    String?

  createdAt DateTime @default(now())

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([outcome])
  @@index([priority])
  @@index([followUpRequired])
  @@index([followUpDate])
  @@index([humanReviewed])
  @@index([reviewedBy])
}

model FollowUpTask {
  id          String     @id @default(cuid())
  customerId  String
  callId      String     @unique
  assignedTo  String
  title       String
  type        TaskType   @default(CALL)
  dueDate     DateTime?
  priority    Priority
  status      TaskStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  completedAt DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  call     Call     @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([assignedTo])
  @@index([dueDate])
  @@index([status])
}

/**
 * ============================================================
 * PAYMENT
 * ============================================================
 * Stores Razorpay payment information for the CRM.
 * Amounts are stored in paise because Razorpay uses paise.
 * Example:
 * Base amount      = ₹100
 * Extra 25%        = ₹25
 * Total amount     = ₹125
 * Database:
 * baseAmountPaise  = 10000
 * extraAmountPaise = 2500
 * totalAmountPaise = 12500
 * Razorpay Order will also use the total amount in paise.
 */
model Payment {
  id String @id @default(cuid())

  customerId String?
  callId     String? @unique

  baseAmountPaise  Int
  extraAmountPaise Int
  totalAmountPaise Int

  razorpayOrderId   String  @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?

  status PaymentStatus @default(CREATED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  call     Call?     @relation(fields: [callId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([callId])
  @@index([status])
  @@index([createdAt])
}
