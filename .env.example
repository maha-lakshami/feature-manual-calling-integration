# ─────────────────────────────────────────────────────────────────────────────
# Aiking Solutions — environment configuration
#
# Copy to `.env` and adjust. The defaults below are the ZERO-CREDENTIAL local
# setup: every external provider runs in `mock` mode, so the whole platform is
# runnable and testable without a Meta / Plivo / Deepgram / Gemini / Razorpay
# account.
#
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Core services ────────────────────────────────────────────────────────────
# Local (node processes, infra from `npm run infra:up`):
DATABASE_URL=postgresql://aiking:aiking@localhost:5433/aiking?schema=public
REDIS_URL=redis://localhost:6379
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Local containers are defined in docker-compose.infra.yml.

# Optional overrides for scripts/pre-staging-assurance.mjs. Leave blank to use
# its safe local PostgreSQL and Redis defaults.
ASSURANCE_DATABASE_URL=
ASSURANCE_REDIS_URL=

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=3001
API_GLOBAL_PREFIX=api
APP_ROLE=api
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Externally reachable origin of this API. Provider callback URLs and signed
# object links are built from it, so it must be what the outside world can
# actually reach — a tunnel host in local development, the load balancer in
# production. Defaults to http://localhost:$API_PORT.
PUBLIC_BASE_URL=http://localhost:3001

# ── Auth ─────────────────────────────────────────────────────────────────────
# CHANGE THIS. In production it belongs in AWS Secrets Manager (spec §12),
# never in a file.
JWT_SECRET=dev-only-change-me-in-production-please-0123456789
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=10

# ── Queue (spec §3.4 — outbound comms are always async) ──────────────────────
# bullmq = real Redis-backed queue (production, docker compose)
# inline  = execute jobs in-process, synchronously (tests, no-Redis local runs)
QUEUE_DRIVER=bullmq
QUEUE_PREFIX=aiking
# Worker concurrency per queue.
QUEUE_CONCURRENCY=5

# ── Provider layer (spec §1.2, §5 — configurable so providers can be swapped) ─
# PROVIDER_MODE sets the default for every provider: mock | live
PROVIDER_MODE=mock
# Per-provider overrides (leave blank to inherit PROVIDER_MODE):
WHATSAPP_MODE=
EMAIL_MODE=
TELEPHONY_MODE=
STT_MODE=
LLM_MODE=
PAYMENTS_MODE=
STORAGE_MODE=

# Mock behaviour knobs — let you exercise failure paths deterministically.
# Fraction of mock provider calls that fail (0 = never, 1 = always).
MOCK_FAILURE_RATE=0
# Simulated provider latency, milliseconds.
MOCK_LATENCY_MS=0
# Seed for deterministic mock ids/transcripts.
MOCK_SEED=aiking-dev

# ── Meta WhatsApp Business Cloud API (spec §6.1) ─────────────────────────────
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Used to verify the X-Hub-Signature-256 header on inbound webhooks.
WHATSAPP_APP_SECRET=mock-meta-app-secret
# Echoed back during Meta's webhook subscription handshake.
WHATSAPP_VERIFY_TOKEN=mock-meta-verify-token

# ── Email — AWS SES or SMTP (spec §6.2) ──────────────────────────────────────
EMAIL_TRANSPORT=smtp
EMAIL_FROM="Aiking Solutions <no-reply@aiking.example>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
AWS_SES_REGION=ap-south-1
# Internal mock callback authentication only; real SNS uses X.509 signatures.
MOCK_EMAIL_WEBHOOK_SECRET=mock-email-webhook-secret
# Comma-separated exact SNS topic ARNs accepted for SES callbacks.
SES_SNS_TOPIC_ARNS=
SNS_CERT_FETCH_TIMEOUT_MS=3000
SNS_CERT_MAX_BYTES=262144
SNS_CERT_CACHE_TTL_MS=3600000

# ── Plivo — telephony (spec §5.1) ────────────────────────────────────────────
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=mock-plivo-auth-token
PLIVO_FROM_NUMBER=+911140000000
# Public base URL Plivo posts call events back to.
PLIVO_CALLBACK_BASE_URL=http://localhost:3001

# ── Deepgram — streaming speech-to-text (spec §5.1) ──────────────────────────
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# ── Gemini — LLM (spec §5.1) ─────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Kept separate so the §5 "swap in Gemini Live later" path is a config change.
GEMINI_LIVE_ENABLED=false

# ── Razorpay — wallet top-ups (spec §8.1) ────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_mock
RAZORPAY_KEY_SECRET=mock-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=mock-razorpay-webhook-secret
RAZORPAY_CURRENCY=INR

# ── Object storage — call recordings, exports (spec §9.1) ────────────────────
# local = write to ./storage on disk (mock mode); s3 = real bucket
S3_BUCKET=aiking-local
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Optional S3-compatible endpoint, for example Cloudflare R2 or MinIO.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Signed downloads are capped at one hour; five minutes is the recommended default.
STORAGE_SIGNED_URL_MAX_EXPIRY_SECONDS=300
# Provider-level upper bound for one object body (50 MiB by default).
STORAGE_MAX_OBJECT_BYTES=52428800
LOCAL_STORAGE_DIR=./storage

# ── Billing defaults (seeded into pricing_rules; editable at runtime, §9.3) ───
# All money in integer paise — never floats (spec §9.1).
PRICE_WHATSAPP_MESSAGE_PAISE=85
PRICE_EMAIL_MESSAGE_PAISE=12
PRICE_AI_CALL_MINUTE_PAISE=650
# Free credits granted to a tenant on onboarding (spec §8.3). ₹500.00
ONBOARDING_FREE_CREDITS_PAISE=50000

# ── Row-Level Security (spec §4.3 — candidate backstop, opt-in) ──────────────
# When true, tenant-scoped tables get RLS policies keyed to app.tenant_id.
# Off by default: the doc lists it as a candidate once >1 paying tenant exists.
ENABLE_RLS=false

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Browser-visible API base. `/api` uses the Vite development proxy locally.
VITE_API_BASE_URL=/api

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Pretty-print logs in dev; set false for JSON (production).
LOG_PRETTY=true
